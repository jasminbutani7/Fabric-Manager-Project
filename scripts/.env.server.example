# Isolated Server-Side Database Migration Credentials Example
# Copy this file to scripts/.env.server and set your Supabase database password.
# This file is strictly for Node.js administrative scripts (db:check, db:migrate)
# and is never bundled into or accessible by the client application.
SUPABASE_DB_PASSWORD=your_supabase_postgres_db_password
SUPABASE_URL=https://your-project-id.supabase.co
